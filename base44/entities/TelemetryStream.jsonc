{
  "name": "TelemetryStream",
  "type": "object",
  "properties": {
    "carId": {
      "type": "string",
      "title": "Car ID"
    },
    "rpm": {
      "type": "number",
      "title": "RPM"
    },
    "speed": {
      "type": "number",
      "title": "Speed"
    },
    "gForce": {
      "type": "number",
      "title": "G-Force"
    },
    "lastPing": {
      "type": "string",
      "title": "Last Ping",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "carId"
  ]
}