{
  "name": "StrategyPreset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Preset Name"
    },
    "strategy_mode": {
      "type": "string",
      "title": "Strategy Mode",
      "enum": [
        "aggressive",
        "balanced",
        "conserve"
      ],
      "default": "balanced"
    },
    "pit_lap": {
      "type": "number",
      "title": "Target Pit Lap"
    },
    "energy_target": {
      "type": "number",
      "title": "Energy Target %"
    },
    "tire": {
      "type": "string",
      "title": "Tire Choice"
    },
    "fuel_config": {
      "type": "string",
      "title": "Fuel Configuration"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "name",
    "strategy_mode"
  ]
}