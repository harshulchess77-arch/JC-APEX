{
  "name": "DriverFeedback",
  "type": "object",
  "properties": {
    "driver_name": {
      "type": "string",
      "title": "Driver Name"
    },
    "session_ref": {
      "type": "string",
      "title": "Session Reference"
    },
    "rating": {
      "type": "number",
      "title": "Rating (1-5)"
    },
    "mood": {
      "type": "string",
      "title": "Mood",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ],
      "default": "neutral"
    },
    "notes": {
      "type": "string",
      "title": "Notes / Post-Session Analysis"
    }
  },
  "required": [
    "driver_name",
    "notes"
  ]
}