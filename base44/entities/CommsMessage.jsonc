{
  "name": "CommsMessage",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "title": "Session ID"
    },
    "sender": {
      "type": "string",
      "title": "Sender",
      "enum": [
        "pit",
        "driver",
        "system"
      ]
    },
    "text": {
      "type": "string",
      "title": "Message Text"
    },
    "audio_url": {
      "type": "string",
      "title": "Audio URL"
    },
    "type": {
      "type": "string",
      "title": "Message Type",
      "enum": [
        "text",
        "audio"
      ],
      "default": "text"
    }
  },
  "required": [
    "session_id",
    "sender",
    "type"
  ]
}