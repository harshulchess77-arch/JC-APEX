# Supabase Configuration (for Vite web app)
# Note: Variables starting with VITE_ are exposed to the client-side code
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key is for server-side API routes only (not exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Alternative environment variable names for Vercel/Next.js compatibility
# If migrating to Next.js, use NEXT_PUBLIC_ prefix instead of VITE_
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
