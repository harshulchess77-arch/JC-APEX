# Supabase Configuration for Gateway Scripts
# Copy this file to .env and fill in your actual values

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (from Supabase Dashboard -> Project Settings -> API)
# This key has full admin access - keep it secret!
# Use this for sync_offline_data.py and any admin operations
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase Anon/Public Key (from Supabase Dashboard -> Project Settings -> API)
# This key is safe for client-side use
# Fallback if service role key is not available
SUPABASE_ANON_KEY=your_anon_key_here

# Alternative key name (for compatibility)
SUPABASE_KEY=your_anon_key_here
