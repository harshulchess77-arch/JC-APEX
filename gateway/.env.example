# Supabase Configuration for Gateway Scripts
# Copy this file to .env and fill in your actual values

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (from Supabase Dashboard -> Project Settings -> API)
# WARNING: Service role key has FULL ADMIN ACCESS to your database.
# Never commit this file to version control. Rotate immediately if leaked.
# Use this ONLY for sync_offline_data.py and admin operations requiring elevated access.
# For normal operations, use the anon key instead.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase Anon/Public Key (from Supabase Dashboard -> Project Settings -> API)
# This key is safe for client-side use and respects RLS policies
# Fallback if service role key is not available
SUPABASE_ANON_KEY=your_anon_key_here

# Alternative key name (for compatibility)
SUPABASE_KEY=your_anon_key_here
